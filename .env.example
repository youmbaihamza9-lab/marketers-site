# رابط ومفاتيح مشروع Supabase (من إعدادات المشروع > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# اسم الـ bucket في Supabase Storage (يجب أن يبدأ بـ NEXT_PUBLIC_ لأن المتصفح يستخدمه أيضاً عند الرفع المباشر)
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=product-images

# سلسلة عشوائية طويلة وسرية، تُستخدم لتوقيع كوكيز الجلسة - غيّرها قبل النشر
SESSION_SECRET=change-this-to-a-long-random-string

# مفتاح سرّي خاص بك فقط، يُستخدم لتفعيل رابط /api/setup لضبط كلمتي المرور أول مرة
# اختر أي نص عشوائي طويل تحفظه لنفسك
SETUP_SECRET=change-this-to-another-long-random-string

# كلمتا المرور الابتدائيتان - يقرأهما رابط /api/setup ليكتبهما في قاعدة البيانات
INITIAL_ADMIN_PASSWORD=0011
INITIAL_MARKETER_PASSWORD=0101
